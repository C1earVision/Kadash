# Environment variables for Vercel frontend deployment
# Set these in Vercel → Project Settings → Environment Variables

VITE_API_URL='https://your-node-backend.vercel.app/api/v1'
VITE_AI_API_URL='https://your-ai-backend.onrender.com'

# Optional: CARTO basemaps API key (free at https://carto.com/basemaps/apikey/)
# If omitted, the dashboard defaults to Esri World Dark Gray Canvas with zero API key required.
# VITE_CARTO_API_KEY='your_carto_api_key'
